# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (Server-only / Webhooks / Stored Procedures — NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Safaricom Daraja M-Pesa Configuration
# Set to 'sandbox' for development or 'production' for live
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=your-consumer-key-here
DARAJA_CONSUMER_SECRET=your-consumer-secret-here
# Sandbox shortcode is 174379; in production use your business Paybill/Till number
DARAJA_SHORTCODE=174379
# Sandbox passkey (provided by Safaricom Daraja Portal)
DARAJA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# Public URL for webhooks (e.g. https://your-domain.com or ngrok)
NEXT_PUBLIC_APP_URL=http://localhost:3000
