# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (Server-only / Webhooks / Stored Procedures — NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Safaricom Daraja M-Pesa Configuration
# Set to 'sandbox' for development or 'production' for live
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=your-consumer-key-here
DARAJA_CONSUMER_SECRET=your-consumer-secret-here
# For Paybill, DARAJA_SHORTCODE is the Paybill shortcode. For Buy Goods STK,
# it is the Safaricom-issued Store/Business Short Code; the receiving Till number
# is stored separately in payment_channels.shortcode (provider mpesa_till).
DARAJA_SHORTCODE=174379
# Sandbox passkey (provided by Safaricom Daraja Portal)
DARAJA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# For separate business Paybills, override the four settings per business code, for example:
# DARAJA_SHORTCODE_HARON_FASHION=...
# DARAJA_PASSKEY_HARON_FASHION=...
# DARAJA_CONSUMER_KEY_HARON_FASHION=...
# DARAJA_CONSUMER_SECRET_HARON_FASHION=...
# Repeat with each code (e.g. ZENITH_PLAST). Never point one business to another's Paybill.
# Public app URL. Localhost is not reachable by Safaricom for callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Full publicly reachable HTTPS Daraja callback endpoint (use an HTTPS tunnel in local development)
DARAJA_CALLBACK_URL=https://your-domain.com/api/daraja/stk/callback
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep private. STK callback URLs receive this token as ?token=...; add the same query parameter
# to registered C2B validation and confirmation URLs. Use HTTPS and protect request logs.
DARAJA_WEBHOOK_TOKEN=replace-with-at-least-64-random-hex-characters

# Africa's Talking SMS (server-only)
AT_USERNAME=sandbox
AT_API_KEY=your-africas-talking-api-key
# Optional approved sender ID
AT_SENDER_ID=
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Protects POST /api/sms/worker, called by a scheduler every minute
SMS_WORKER_SECRET=replace-with-64-random-hex-characters
# Protects /api/sms/delivery?token=... configured as the Africa's Talking callback URL
SMS_DELIVERY_TOKEN=use-a-different-64-character-random-token
